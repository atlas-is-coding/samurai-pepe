# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="file:./samurai_pepe.db"

# Ключ шифрования для Next.js (для server actions)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="mySecretKeyForNextJsServerActions123"

# Solana RPC Endpoint
NEXT_PUBLIC_SOLANA_RPC_ENDPOINT="https://api.devnet.solana.com"

# Solana Network (devnet, testnet, mainnet-beta)
NEXT_PUBLIC_SOLANA_NETWORK="devnet"

# OAuth URLs
DISCORD_OAUTH_URL="https://discord.com/api/oauth2/authorize"
TWITTER_OAUTH_URL="https://twitter.com/i/oauth2/authorize"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server reference manifest encryption key
SERVER_REFERENCE_MANIFEST_ENCRYPTION_KEY="q10HgUhKrlAo6TvR0Xfvu6XzwUPHXawdZfO63Miozzo="

# Solana NFT программа
NEXT_PUBLIC_NFT_PROGRAM_ID="G37UyZuJkHdnF9ko2p8FLUtyPYZSYQ1ihjic9G1RCQRf"

# Адрес владельца коллекции NFT (требуется для минта)
NEXT_PUBLIC_COLLECTION_AUTHORITY="ВАША_ПУБЛИЧНАЯ_СЕТЬ_ЗДЕСЬ"

# Адрес данных о коллекции NFT (PDA)
NEXT_PUBLIC_COLLECTION_DATA_PDA="АДРЕС_ДАННЫХ_КОЛЛЕКЦИИ_ЗДЕСЬ"